<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="brand brand--footer" href="/" aria-label="<%= site.company.name %> home">
          <%- include('logo-mark') %>
          <span class="brand__name"><%= site.company.shortName %></span><span class="brand__suffix">Technologies</span>
        </a>
        <p><%= site.company.tagline %></p>
        <% const socials = Object.entries(site.company.social).filter(([, url]) => url); %>
        <% if (socials.length) { %>
        <ul class="social" aria-label="Follow us">
          <% socials.forEach(([network, url]) => { %>
            <li><a href="<%= url %>" rel="noopener" target="_blank" aria-label="<%= site.company.shortName %> on <%= { linkedin: 'LinkedIn', x: 'X', github: 'GitHub', instagram: 'Instagram' }[network] || network %>"><%- include('social-icon', { network }) %></a></li>
          <% }) %>
        </ul>
        <% } %>
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        <div>
          <p class="site-footer__heading">Company.</p>
          <ul>
            <li><a href="/about">About us</a></li>
            <li><a href="/careers">Careers</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="site-footer__heading">Services.</p>
          <ul>
            <% site.engagementModels.forEach((m) => { %><li><a href="/services#<%= m.id %>"><%= m.name %></a></li><% }) %>
            <% site.services.slice(0, 4).forEach((s) => { %><li><a href="/services#<%= s.id %>"><%= s.name %></a></li><% }) %>
          </ul>
        </div>
        <div>
          <p class="site-footer__heading">Explore.</p>
          <ul>
            <li><a href="/technologies">Technologies</a></li>
            <li><a href="/industries">Industries</a></li>
            <li><a href="/services">All services</a></li>
          </ul>
        </div>
        <div>
          <p class="site-footer__heading">Get in touch.</p>
          <ul>
            <li><a href="mailto:<%= site.company.email %>"><%= site.company.email %></a></li>
            <li><a href="tel:<%= site.company.phone.replace(/\s+/g, '') %>"><%= site.company.phone %></a></li>
            <li class="site-footer__address"><%= site.company.address %></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="newsletter" id="newsletter">
      <div>
        <p class="newsletter__title">Get practical notes on building and scaling software teams.</p>
        <p class="newsletter__sub">One email a month. Unsubscribe any time.</p>
      </div>
      <form class="newsletter__form" action="/subscribe" method="post" data-newsletter novalidate>
        <label class="sr-only" for="newsletter-email">Work email</label>
        <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required>
        <button class="btn btn--primary" type="submit">Subscribe</button>
        <p class="newsletter__status" role="status" data-newsletter-status><%=
          subscribed === '1' ? 'You are subscribed. Look out for our next issue.' :
          subscribed === 'invalid' ? 'Enter a valid email address.' : '' %></p>
      </form>
    </div>

    <div class="site-footer__legal">
      <p>&copy; <%= year %> <%= site.company.name %>. All rights reserved.</p>
      <ul>
        <li><a href="/privacy">Privacy policy</a></li>
        <li><a href="/terms">Terms of service</a></li>
        <li><a href="/sitemap.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>
</body>
</html>
