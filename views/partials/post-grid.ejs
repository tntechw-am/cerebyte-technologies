<ul class="post-grid">
  <% posts.forEach((post) => { %>
    <li class="post-card">
      <a class="post-card__media" href="/blog/<%= post.slug %>" tabindex="-1" aria-hidden="true"><%- include('cover', { post }) %></a>
      <p class="post-card__meta"><time datetime="<%= post.date %>"><%= formatDate(post.date) %></time>, <%= post.readTime %></p>
      <h3 class="post-card__title"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3>
      <p><%= post.excerpt %></p>
    </li>
  <% }) %>
</ul>
