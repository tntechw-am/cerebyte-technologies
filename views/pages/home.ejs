<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main">

  <section class="hero" aria-labelledby="hero-title">
    <canvas class="hero__canvas" data-network aria-hidden="true"></canvas>
    <div class="container hero__inner">
      <h1 class="hero__title" id="hero-title"><%- headline('Turn your roadmap into shipped software.') %></h1>
      <p class="hero__lede">Cerebyte Technologies gives product teams vetted, AI-fluent engineers across 40+ technologies. They work your hours and can start within two weeks.</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact">Book a call</a>
        <a class="btn btn--ghost btn--lg" href="/services">Explore services</a>
      </div>
    </div>
    <div class="container hero__clients">
      <div class="hero__clients-inner">
        <p>Product teams that build with us</p>
        <ul class="clients">
          <% site.clients.forEach((c, i) => { %><li class="clients__item clients__item--<%= i % 3 %>"><%= c %></li><% }) %>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 class="h2" id="services-title"><%- headline('Every discipline your product needs, from first sketch to release.') %></h2>
        <a class="link-strong" href="/services">All services</a>
      </div>
      <div class="service-grid">
        <% site.services.slice(0, 6).forEach((s) => { %>
          <article class="service">
            <h3 class="service__title"><a href="/services#<%= s.id %>"><%= s.name %></a></h3>
            <p><%= s.summary %></p>
            <ul class="tags">
              <% s.tags.slice(0, 4).forEach((t) => { %><li><a class="tag" href="/technologies"><%= t %></a></li><% }) %>
            </ul>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="stack-title">
    <div class="container stack-head">
      <h2 class="h2" id="stack-title"><%- headline('Your stack, covered.') %></h2>
      <p class="lede">Our engineers work across 40+ languages, frameworks and clouds, and use the AI coding tools that are changing how software gets built.</p>
    </div>
    <div class="marquee" data-marquee>
      <% site.techStrip.forEach((row, r) => { %>
        <div class="marquee__row<%= r % 2 ? ' marquee__row--reverse' : '' %>">
          <ul class="marquee__track">
            <% row.forEach((t) => { %><li class="pill"><%= t %></li><% }) %>
          </ul>
          <%# Visual copies so the loop is seamless on wide screens; hidden from screen readers. %>
          <% for (let copy = 0; copy < 3; copy++) { %>
          <ul class="marquee__track" aria-hidden="true">
            <% row.forEach((t) => { %><li class="pill"><%= t %></li><% }) %>
          </ul>
          <% } %>
        </div>
      <% }) %>
    </div>
    <div class="container stack-foot">
      <a class="link-strong" href="/technologies">See all technologies</a>
      <button class="marquee-toggle" type="button" aria-pressed="false" data-marquee-toggle>Pause animation</button>
    </div>
  </section>

  <section class="section section--ink testimonials" aria-labelledby="testimonials-title">
    <div class="container testimonials__inner">
      <div class="testimonials__intro">
        <h2 class="h2" id="testimonials-title"><%- headline('Teams that ship with us keep shipping with us.') %></h2>
        <p>Most clients start with one team and add more. Our average relationship lasts over three years.</p>
      </div>
      <div class="carousel" data-carousel aria-roledescription="carousel" aria-label="Client testimonials">
        <div class="carousel__viewport">
          <% site.testimonials.forEach((t, i) => { %>
            <figure class="quote<%= i === 0 ? ' is-active' : '' %>" data-slide aria-roledescription="slide" aria-label="<%= i + 1 %> of <%= site.testimonials.length %>"<%- i === 0 ? '' : ' inert aria-hidden="true"' %>>
              <blockquote><p><%= t.quote %></p></blockquote>
              <figcaption>
                <span class="avatar" aria-hidden="true"><%= t.name.split(' ').map((n) => n[0]).join('') %></span>
                <span><strong><%= t.name %></strong><br><%= t.role %></span>
              </figcaption>
            </figure>
          <% }) %>
        </div>
        <div class="carousel__controls">
          <button class="icon-btn" type="button" data-prev aria-label="Previous testimonial">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <p class="carousel__count" aria-live="polite"><span data-current>1</span> / <%= site.testimonials.length %></p>
          <button class="icon-btn" type="button" data-next aria-label="Next testimonial">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="stats-title">
    <div class="container stats">
      <div class="stats__intro">
        <h2 class="h2" id="stats-title"><%- headline('Quality is our floor, not our goal.') %></h2>
        <p class="lede">Every engagement has a named account lead, weekly reporting and a clear way to change course.</p>
      </div>
      <dl class="stats__list">
        <% site.stats.forEach((s) => { %>
          <div class="stat"><dt><%= s.label %></dt><dd><%= s.value %></dd></div>
        <% }) %>
      </dl>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="why-title"><%- headline('Why teams choose Cerebyte.') %></h2>
      </div>
      <div class="why">
        <div class="why__reasons">
          <% site.reasons.forEach((r) => { %>
            <div class="reason">
              <h3 class="reason__title"><%= r.title %></h3>
              <p><%= r.text %></p>
            </div>
          <% }) %>
        </div>
        <div class="assemble" data-assemble>
          <h3 class="assemble__title">Assemble your team.</h3>
          <p id="assemble-help">Pick the roles you need and we will bring them to the call.</p>
          <ul class="chips" aria-describedby="assemble-help">
            <% site.roles.forEach((role) => { %>
              <li><button class="chip" type="button" aria-pressed="false" data-role="<%= role %>"><%= role %></button></li>
            <% }) %>
          </ul>
          <a class="btn btn--primary btn--block" href="/contact" data-assemble-link>Book a call</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="models-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="models-title"><%- headline('Keep full control, or hand it all over.') %></h2>
        <p class="lede">From one embedded engineer to a fully managed project, every engagement is shaped around your workflow and priorities.</p>
      </div>
      <div class="models" data-tabs>
        <div class="models__tabs" role="tablist" aria-label="Engagement models" aria-orientation="vertical">
          <% site.engagementModels.forEach((m, i) => { %>
            <button class="models__tab" role="tab" type="button" id="tab-<%= m.id %>" aria-controls="panel-<%= m.id %>" aria-selected="<%= i === 0 %>" tabindex="<%= i === 0 ? 0 : -1 %>">
              <span class="models__q"><%= m.question %></span>
              <span class="models__name"><%= m.name %></span>
            </button>
          <% }) %>
        </div>
        <% site.engagementModels.forEach((m, i) => { %>
          <div class="models__panel" role="tabpanel" id="panel-<%= m.id %>" aria-labelledby="tab-<%= m.id %>" tabindex="0"<%- i === 0 ? '' : ' hidden' %>>
            <div class="models__copy">
              <h3 class="h3"><%= m.name %></h3>
              <p><%= m.text %></p>
              <ul class="checks"><% m.points.forEach((p) => { %><li><%= p %></li><% }) %></ul>
              <a class="link-strong" href="/contact?model=<%= m.id %>">Discuss <%= m.name.toLowerCase() %></a>
            </div>
            <%- include('../partials/model-art', { id: m.id }) %>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 class="h2" id="process-title"><%- headline('Getting started takes three steps.') %></h2>
        <a class="btn btn--primary" href="/contact">Book a call</a>
      </div>
      <ol class="steps">
        <% site.processSteps.forEach((s, i) => { %>
          <li class="step">
            <span class="step__num" aria-hidden="true"><%= i + 1 %></span>
            <h3 class="step__title"><%= s.title %></h3>
            <p><%= s.text %></p>
          </li>
        <% }) %>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="blog-title">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 class="h2" id="blog-title"><%- headline('From the blog.') %></h2>
        <a class="link-strong" href="/blog">All articles</a>
      </div>
      <%- include('../partials/post-grid', { posts: site.posts.slice(0, 3) }) %>
    </div>
  </section>

  <%- include('../partials/cta-band') %>
</main>
<%- include('../partials/footer') %>
