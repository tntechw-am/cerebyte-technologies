# Copy to .env (or set these in your hosting dashboard).
PORT=3000
NODE_ENV=production
SITE_URL=https://www.your-domain.com

# Optional: where form submissions are saved (defaults to ./storage)
# STORAGE_DIR=/var/data/cerebyte

# Optional: post each new enquiry to a webhook (Slack workflow, Zapier, Make, n8n...)
# LEAD_WEBHOOK_URL=https://hooks.example.com/...

# Optional: email each new enquiry (requires `npm install nodemailer`)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=website@your-domain.com
# LEAD_EMAIL_TO=sales@your-domain.com
